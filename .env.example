# Required in production. The API refuses to start if this is left as the example value.
DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-string
# Public website origin (Open Graph / metadata):
SITE_URL=https://reelsdl.net
# Production API origin. Leave unset for local `next dev` (same-origin /api).
# On Vercel this is baked into the client bundle:
NEXT_PUBLIC_API_URL=https://get.reelsdl.net
# Required when Instagram gates anonymous GraphQL (typical on Vercel).
# Netscape cookie-file contents or a header string that includes sessionid.
# INSTAGRAM_COOKIES=
# INSTAGRAM_COOKIES_FILE=/absolute/path/to/instagram-cookies.txt
# Optional: override the Instagram GraphQL doc id(s) used by the fast path (comma-separated).
# Current query: PolarisLoggedOutDesktopWWWPostRootContentQuery
# INSTAGRAM_GRAPHQL_DOC_IDS=27130156389949648
# YTDLP_BIN=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg
